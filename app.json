{
  "expo": {
    "name": "CyberSentinel",
    "slug": "CyberSentinel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1E3A5F",
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow CyberSentinel to listen for rover voice commands.",
          "speechRecognitionPermission": "Allow CyberSentinel to transcribe your voice commands."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cybersentinel.rover"
    },
    "android": {
      "package": "com.cybersentinel.rover",
      "adaptiveIcon": {
        "backgroundColor": "#1E3A5F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
