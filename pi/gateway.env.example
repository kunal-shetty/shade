# CyberSentinel gateway configuration (copy to /opt/cybersentinel/gateway.env)
#
# After a fresh flash the Pi's name should be cybersentinel so mDNS resolves
# `cybersentinel.local` on the phone. `raspi-config` -> System Options ->
# Hostname, or:  sudo hostnamectl set-hostname cybersentinel

CS_HOSTNAME=cybersentinel

# Arduino USB port. `auto` probes /dev/ttyACM* (a genuine Uno R3) then
# /dev/ttyUSB* (CH340/CP2102 clones). Pin an explicit path to override.
CS_SERIAL_PORT=auto
CS_SERIAL_BAUD=115200

# Ports
CS_API_PORT=8000
CS_WS_PORT=8765
CS_MQTT_PORT=1883

# Text-to-speech on the Pi's speaker: auto | espeak-ng | espeak | spd-say | none
CS_TTS_ENGINE=auto
# espeak voice variant: base language + variant. The +f* variants are female
# (a bare "en" is espeak's male voice), so this defaults to a light, friendly
# female voice. Try en+f1..f5 (higher = lighter) or en+m1..m7 for male.
# If the variant is not in your espeak build the gateway tries the other female
# variants before ever dropping to the base language.
CS_TTS_VOICE=en+f3
CS_TTS_RATE=165
# 0-99. Higher = chirpier. ~70 is cheerful, ~50 is neutral, ~85 is cartoonish.
CS_TTS_PITCH=70
# Optional: high-quality voice via piper (see pi/README.md)
# CS_PIPER_MODEL=/opt/piper/en_US-lessac-medium.onnx

# Boot greeting — spoken on the Pi's speaker by cybersentinel-greet.service at
# every power-up (no app or browser involved). Comment out to silence it.
CS_BOOT_GREETING=Good morning Mohini maam
# Seconds to wait after boot for ALSA/audio routing to settle.
CS_BOOT_GREET_DELAY=8

# Autonomous boot demo — after the greeting the rover DRIVES ITSELF in a loop:
# FORWARD -> LEFT -> RIGHT -> BACKWARD, CS_DEMO_STEP seconds each, forever.
# No app or server involved; the Pi writes direction words to the Arduino
# serial port directly. Safety stop on shutdown/reboot. Disable with:
#   sudo systemctl disable --now cybersentinel-demo.service
CS_DEMO_STEP=4

# ---------------------------------------------------------------------------
# Groq — natural wording for the replies the Pi speaks
#
# JEV on the phone classifies a voice command but cannot write prose, so the app
# sends a fixed template with every reply ("Rolling forward at 60 percent.").
# With a key set here, the gateway asks Groq to reword that template into one
# natural sentence before it is spoken, and reports the text it actually used.
#
# The template stays the source of truth: the model is instructed never to add,
# remove or change a fact, so it can improve the phrasing but not invent a
# battery level. Any failure (no key, no network, bad reply) falls back to
# speaking the template verbatim, so this can never silence a reply.
#
# Key: https://console.groq.com/keys  — leave unset to keep template replies.
# CS_GROQ_API_KEY=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
# Small and fast, which is what a spoken reply needs. Any Groq chat model works.
CS_GROQ_MODEL=llama-3.1-8b-instant
# Seconds to wait for Groq before falling back to the template.
CS_GROQ_TIMEOUT=4

CS_ENABLE_MDNS=1

# Camera / MJPEG stream (served by the gateway on CS_CAMERA_PORT)
CS_CAMERA_ENABLE=1
# auto | picamera | usb | external | off
#   auto     = picamera -> external -> usb, whichever is available
#   picamera = CSI Camera Module via Picamera2 (needs python3-picamera2)
#   usb      = USB webcam through ffmpeg
#   external = proxy an MJPEG URL you already serve yourself
CS_CAMERA_SOURCE=auto
# Only used when CS_CAMERA_SOURCE=external, e.g. your own Flask/Picamera2 server:
# CS_CAMERA_EXTERNAL_URL=http://127.0.0.1:5000/video
CS_CAMERA_DEVICE=/dev/video0
CS_CAMERA_PORT=8080
CS_CAMERA_SIZE=640x480
CS_CAMERA_FPS=20
# Rotate if the camera is mounted upside down: 0 | 90 | 180 | 270
CS_CAMERA_ROTATE=0
# Optional v4l2 control applied for night mode, e.g. exposure_auto=1
CS_CAMERA_NIGHT_CTRL=
# Where recorded clips are written (POST /camera/record)
CS_RECORD_DIR=/opt/cybersentinel/recordings
